{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Vienna",
  "packageRules": [
    {
      "groupName": "Docker image digest updates",
      "schedule": [
        "* 2-5 1,15 * *"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "description": "Bundle Python minor and patch updates, every branch builds two images in ghcr-branch.yml",
      "groupName": "python non-major",
      "matchManagers": [
        "poetry"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "pycryptodomex is pinned because minor versions break, see pyproject.toml",
      "groupName": null,
      "matchPackageNames": [
        "pycryptodomex"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "prospector needs a matching pylint major, a conflict here must not block the lock of python non-major. separateMajorMinor keeps majors and minors on one branch",
      "groupName": "python linters",
      "matchPackageNames": [
        "prospector",
        "pylint",
        "astroid",
        "autopep8",
        "PyCQA/prospector"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "CI tests the Python of the image: the next Python of both is a decision, taken together",
      "matchManagers": [
        "github-actions",
        "dockerfile"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.15([.-]|$)/"
    },
    {
      "description": "The supported Python range is a decision, not an update",
      "matchManagers": [
        "poetry"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "A new pandas major needs a look at the pages, its tests don't see charts and tables",
      "matchManagers": [
        "poetry"
      ],
      "matchPackageNames": [
        "pandas"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "plotly 7 brings plotly.js 4: the language files and the fetch of the map tiles depend on its major (U26)",
      "matchManagers": [
        "poetry"
      ],
      "matchPackageNames": [
        "plotly"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "docker-compose.yml is what users copy, keep it on the latest tag without a digest",
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false
    }
  ]
}
