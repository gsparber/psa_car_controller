{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Vienna",
  "packageRules": [
    {
      "groupName": "Docker image digest updates",
      "schedule": [
        "* 2-5 1,15 * *"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "description": "Bundle Python minor and patch updates, every branch builds two images in ghcr-branch.yml",
      "groupName": "python non-major",
      "matchManagers": [
        "poetry"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "pycryptodomex is pinned because minor versions break, see pyproject.toml",
      "groupName": null,
      "matchPackageNames": [
        "pycryptodomex"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "prospector needs a matching pylint major, a conflict here must not block the lock of python non-major. separateMajorMinor keeps majors and minors on one branch",
      "groupName": "python linters",
      "matchPackageNames": [
        "prospector",
        "pylint",
        "astroid",
        "autopep8",
        "PyCQA/prospector"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "CI tests the Python of the image, Debian 13 ships 3.13. Change this rule with the Debian version",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.13(\\.|$)/"
    },
    {
      "description": "The supported Python range is a decision, not an update",
      "matchManagers": [
        "poetry"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Ubuntu 26.04 has no libatlas-base-dev, which test.yml and apk-format.yml install",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^2[24]\\.04$/"
    },
    {
      "description": "A new Debian changes Python and the system packages: the tag alone broke the pip step of the image from 12 to 13",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "debian"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The image uses the pandas of Debian 13 (2.2.3), a new major also needs a look at the pages",
      "matchManagers": [
        "poetry"
      ],
      "matchPackageNames": [
        "pandas"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "plotly 7 brings plotly.js 4: the language files and the fetch of the map tiles depend on its major (U26)",
      "matchManagers": [
        "poetry"
      ],
      "matchPackageNames": [
        "plotly"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "docker-compose.yml is what users copy, keep it on the latest tag without a digest",
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false
    }
  ]
}
