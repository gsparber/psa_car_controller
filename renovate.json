{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Vienna",
  "packageRules": [
    {
      "groupName": "Docker image digest updates",
      "schedule": [
        "* 2-5 1,15 * *"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "description": "Bundle Python minor and patch updates, every branch builds two images in ghcr-branch.yml",
      "groupName": "python non-major",
      "matchManagers": [
        "poetry"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "pycryptodomex is pinned because minor versions break, see pyproject.toml",
      "groupName": null,
      "matchPackageNames": [
        "pycryptodomex"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "prospector needs a matching pylint major, a conflict here must not block the lock of python non-major. separateMajorMinor keeps majors and minors on one branch",
      "groupName": "python linters",
      "matchPackageNames": [
        "prospector",
        "pylint",
        "astroid",
        "autopep8",
        "PyCQA/prospector"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "CI tests the Python of the image, Debian 12 ships 3.11. U20/U21 move image and CI to 3.13 together, change this rule with them",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.11(\\.|$)/"
    },
    {
      "description": "The supported Python range is a decision, not an update",
      "matchManagers": [
        "poetry"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Ubuntu 26.04 has no libatlas-base-dev, which test.yml and apk-format.yml install",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^2[24]\\.04$/"
    },
    {
      "description": "Debian 13 and numpy 2 only work together (U20): the Debian tag alone breaks the pip step, numpy 2 on Debian 12 breaks pandas",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "debian"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "See the Debian rule above (U20)",
      "matchManagers": [
        "poetry"
      ],
      "matchPackageNames": [
        "numpy"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "docker-compose.yml is what users copy, keep it on the latest tag without a digest",
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false
    }
  ]
}
